{
  "name": "cool-buddy",
  "version": "1.0.8",
  "description": "a cool tool for you",
  "packageManager": "pnpm@10.33.3",
  "main": "./out/main/index.js",
  "author": "ten.x",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "chcp 65001 && electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "node scripts/install-app-deps.cjs",
    "native:rebuild": "node scripts/install-app-deps.cjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac --arm64",
    "build:linux": "pnpm run build && electron-builder --linux",
    "release:upload:oss": "node scripts/upload-release-assets-to-oss.mjs release-assets"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@langchain/anthropic": "^1.3.29",
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.5",
    "@xterm/addon-fit": "^0.11.0",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.9.0",
    "decamelize": "1.2.0",
    "electron-updater": "^6.3.9",
    "element-plus": "^2.14.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "ssh2": "^1.17.0",
    "vue-markdown-stream": "^0.5.9",
    "vue-router": "^5.0.6",
    "xterm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-vue": "^6.0.2",
    "ali-oss": "^6.23.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.9.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "cpu-features",
      "electron",
      "electron-winstaller",
      "esbuild",
      "ssh2"
    ]
  }
}
